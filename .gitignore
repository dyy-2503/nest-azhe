# 运行数据（聊天记录、图片、语音、备份）——绝对不能进仓库
data/
!data/.gitkeep

# 桥接的密钥与本地下载的媒体
bridge/nest-me.json
bridge/_key.txt
bridge/nest-bridge.state.json
bridge/.nest-images/
bridge/.nest-videos/
bridge/.nest-voices/

# 依赖与工具
node_modules/
tools/
dist/

# 证书/密钥
*.pfx
*.pem
*.key
!package-lock.json
.env

# 测试与临时
.nest-test/
coverage/
*.log
*.err

# 桌面客户端（Electron）构建产物
desktop/node_modules/
desktop/dist/
desktop/release/

# 安卓构建产物（android 工程本身要提交，产物不提交）
mobile/node_modules/
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties
mobile/out/
mobile/www/icon.png
